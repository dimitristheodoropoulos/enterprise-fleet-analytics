# Copy this file to .env in the same folder and fill in your real values.
# .env should be in .gitignore — never commit real credentials.

# Used by load_to_supabase.py and analyze_coverage_gap.py (psycopg2)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Used by dbt (profiles.yml.example) — same database, split into parts
SUPABASE_HOST=YOUR_SUPABASE_HOST
SUPABASE_USER=postgres
SUPABASE_PASSWORD=YOUR_PASSWORD
SUPABASE_DBNAME=postgres
